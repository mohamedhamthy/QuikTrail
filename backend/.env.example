# Server Configuration
PORT=5000

# Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/quiktrail?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Initial Admin Credentials
ADMIN_EMAIL=admin@quiktrail.local
ADMIN_PASSWORD=your_secure_admin_password
